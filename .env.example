# CIRCUITORIUM 环境变量示例
# 用法：复制成 .env 再填真实值（.env 已在 .gitignore 里，不会被提交）。
# 说明：**这些只有服务器版需要**。桌面版 / 便携版完全不读环境变量，不需要任何配置。

# ---- 服务器版必需 ----
# 登录令牌的签名密钥：一串长随机字符串即可（换掉之后所有人需要重新登录）
JWT_SECRET=your-jwt-secret-key-change-in-production

# ---- AI 识别（可选，不填也能用）----
# 不填时识别设置默认「手动录入」：元件手动敲，工具箱其它功能一概不受影响。
# 想开 AI 识别，二选一：

# A. OpenAI 兼容接口（官方，或任何兼容的代理地址）
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# B. 百度 AI 开放平台（AI_PROVIDER=baidu，或作为兜底）
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key
