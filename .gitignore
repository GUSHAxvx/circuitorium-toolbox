# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite database
data.db
data.db-*

# uploaded images
public/uploads/

/当前公网地址.txt

# 便携版构建产物
/便携版/
/.portable-build/

# 桌面版构建产物（exe 与安装包都能重新生成）
/桌面版/

# Tauri / Rust 构建产物（真正的 target 在 D 盘，这里兜底）
/src-tauri/target/
/src-tauri/gen/schemas/

# 验证脚本的临时截图
/截图/

# 元件库：图形来自 Fritzing（CC BY-SA 3.0）。已确定接受署名方案，所以渲染好的元件图随仓库分发；
# 原始 SVG 只是中间产物，不提交（跑 extract_fritzing.py 可随时重新生成）
/元件数据库/数据/svg_raw/
