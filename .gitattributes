# 换行符统一：源码用 LF，批处理脚本锁死 CRLF
# 背景（两个都踩过）：
#   - 工具/portable/启动.bat 若是 LF，.bat 里的 goto 标签会失效、便携版起不来 → 必须 CRLF
#   - 工具/portable/server.ps1 只挑「UTF-8 + BOM」，换行符 LF/CRLF 都行（BOM 已写在文件里）
* text=auto

.gitattributes text eol=lf
.gitignore     text eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ps1  text eol=lf

# Windows 批处理：工作区保留 CRLF，不要自动转换
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制：不要做任何换行或编码处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.exe  binary
*.dll  binary
*.zip  binary
*.ecp  binary
*.db   binary
