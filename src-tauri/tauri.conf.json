{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CIRCUITORIUM Toolbox",
  "version": "1.0.0",
  "identifier": "com.circuitorium.toolbox",
  "build": {
    "frontendDist": "../dist-toolbox/site"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CIRCUITORIUM 工具箱",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
